<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="740.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="studentrecords.DashboardController">

   <!-- HEADER -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #144b37; -fx-padding: 0 20 0 20;">
         <children>
            <Label prefHeight="27.0" prefWidth="233.0" text="Viri Student Record System" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Semibold" size="18.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color:             transparent; -fx-border-color: white; -fx-border-radius: 4;             -fx-text-fill: white; -fx-cursor: hand;" text="Logout" />
         </children>
      </HBox>
   </top>

   <!-- STUDENT FORM -->
   <left>
      <VBox prefWidth="280.0" spacing="6.0" style="-fx-background-color: #e8f4e9; -fx-padding: 20;">
         <children>
            <Label text="Student Details" textFill="#1F2937">
               <font>
                  <Font name="Segoe UI Semibold" size="16.0" />
               </font>
            </Label>
            <Label text="Student ID" textFill="#374151" />
            <TextField fx:id="idField" promptText="e.g. 202647583" />
            <Label text="Full Name" textFill="#374151" />
            <TextField fx:id="nameField" promptText="e.g. Coco Martin" />
            <Label text="Course / Program" textFill="#374151" />
            <TextField fx:id="courseField" promptText="e.g. BSCS" />
            <Label text="Year Level" textFill="#374151" />
            <ComboBox fx:id="yearCombo" maxWidth="Infinity" promptText="Select year" />
            <Label text="Email" textFill="#374151" />
            <TextField fx:id="emailField" promptText="name@school.edu" />

            <HBox spacing="8.0">
               <children>
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleAdd" style="-fx-background-color: #14532D; -fx-text-fill: white; -fx-cursor: hand;" text="Add" HBox.hgrow="ALWAYS" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleUpdate" style="-fx-background-color: #2F6FED; -fx-text-fill: white; -fx-cursor: hand;" text="Update" HBox.hgrow="ALWAYS" />
               </children>
               <VBox.margin>
                  <Insets top="14.0" />
               </VBox.margin>
            </HBox>
            <HBox spacing="8.0">
               <children>
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleDelete" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-cursor: hand;" text="Delete" HBox.hgrow="ALWAYS" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleClear" style="-fx-background-color: #6B7280; -fx-text-fill: white; -fx-cursor: hand;" text="Clear" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </left>

   <!-- Table & Search -->
   <center>
      <VBox spacing="10.0" style="-fx-background-color: #f8f7ef; -fx-padding: 20;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <TextField fx:id="searchField" prefWidth="320.0" promptText="Search by ID, name or course..." />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="countLabel" textFill="#f8f7ef" />
               </children>
            </HBox>
            <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="idCol" prefWidth="110.0" text="Student ID" />
                  <TableColumn fx:id="nameCol" prefWidth="190.0" text="Full Name" />
                  <TableColumn fx:id="courseCol" prefWidth="110.0" text="Course" />
                  <TableColumn fx:id="yearCol" prefWidth="70.0" text="Year" />
                  <TableColumn fx:id="emailCol" prefWidth="170.0" text="Email" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
